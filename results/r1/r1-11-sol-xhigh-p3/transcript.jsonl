{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \".venv/bin/python - <<'PY'\nimport concurrent.futures,sys,statistics\nsys.path.insert(0,'tools')\nvariants={'static':(0,0,0),'mild':(0,1,3),'egg':(1,1,3),'strong':(1,2,5)}\ndef one(task):\n name,(eg,cm,sy),seed=task\n import engine\n def make():\n  a=engine.load_agent('main.py');cf=a.__globals__['_crop_for']\n  def plan(x,y,shops,prices=None):\n   g=eg*sum(s in ('BAKERY','BRUNCH_SPOT') for s in shops)\n   c=4+cm*sum(s in ('PIZZA_SHOP','ICE_CREAM_SHOP','SMOOTHIE_SHOP') for s in shops)\n   sh=3+sy*sum(s=='YARN_STORE' for s in shops)\n   wh=g+c+sh+1\n   r=((x*53+y*29+x*y*11+17)%101)\n   if r<g:return 'GOOSE'\n   if r<g+c:return 'COW'\n   if r<g+c+sh:return 'SHEEP'\n   if r<g+c+sh+wh:return 'WHEAT'\n   return cf(x,y,shops,prices)\n  a.__globals__['_plan_for']=plan;return a\n return name,seed,engine.play(make(),make(),seed)\ntasks=[(n,v,s) for n,v in variants.items() for s in range(1,5)]\nwith concurrent.futures.ProcessPoolExecutor(max_workers=8) as ex:r=list(ex.map(one,tasks))\nfor n in variants:\n vals=[x for a,s,z in r if a==n for x in z]\n print(n,round(statistics.mean(vals)),min(vals),max(vals),[(s,z) for a,s,z in r if a==n])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
