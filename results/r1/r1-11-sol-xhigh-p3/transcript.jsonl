{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \".venv/bin/python - <<'PY'\nimport sys,time\nsys.path.insert(0,'tools'); import engine\n\ndef make(weights):\n a=engine.load_agent('main.py'); crops=['WHEAT','CARROT','TOMATO','STRAWBERRY','MELON']; total=sum(weights)\n def cf(x,y,shops):\n  rank=((x*37+y*61+x*y*7)%101)/101; z=0\n  for c,w in zip(crops,weights):\n   z+=w/total\n   if rank<z:return c\n  return crops[-1]\n a.__globals__['_crop_for']=cf\n return a\nfor name,w in [('wheat',[100,0,0,0,0]),('carrot',[0,100,0,0,0]),('tomato',[0,0,100,0,0]),('straw',[0,0,0,100,0]),('melon',[0,0,0,0,100]),('exp',[8,18,28,30,16]),('late',[5,15,35,40,5])]:\n a=make(w); b=make(w); t=time.time();sc=engine.play(a,b,1); print(name,sc,round(time.time()-t,2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
