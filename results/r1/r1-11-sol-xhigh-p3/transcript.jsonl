{"type":"item.started","item":{"id":"item_122","type":"command_execution","command":"/bin/bash -lc \".venv/bin/python - <<'PY'\nimport concurrent.futures,sys,statistics\nsys.path.insert(0,'tools');variants=('fixed','milk','shop')\ndef one(t):\n name,seed=t;import engine\n def make():\n  a=engine.load_agent('main.py')\n  if name=='milk':\n   def d(o):\n    sh=o['town']['unlocked_shops'];m=sum(x in ('PIZZA_SHOP','ICE_CREAM_SHOP','SMOOTHIE_SHOP') for x in sh)\n    return {'GOOSE':2,'COW':min(4,2+m),'SHEEP':1}\n   a.__globals__['_desired_animals']=d\n  elif name=='shop':\n   def d(o):\n    sh=o['town']['unlocked_shops'];e=sum(x in ('BAKERY','BRUNCH_SPOT') for x in sh);m=sum(x in ('PIZZA_SHOP','ICE_CREAM_SHOP','SMOOTHIE_SHOP') for x in sh);y=sum(x=='YARN_STORE' for x in sh)\n    sheep=min(3,1+2*y);cows=min(4,2+m,6-sheep)\n    return {'GOOSE':min(4,2+e),'COW':cows,'SHEEP':sheep}\n   a.__globals__['_desired_animals']=d\n  return a\n return name,seed,engine.play(make(),make(),seed)\nwith concurrent.futures.ProcessPoolExecutor(max_workers=8) as ex:r=list(ex.map(one,[(n,s)for n in variants for s in range(1,13)]))\nfor n in variants:\n vals=[x for a,s,z in r if a==n for x in z];means=[sum(z)/2 for a,s,z in r if a==n]\n print(n,'mean',round(statistics.mean(vals)),'median',round(statistics.median(vals)),'min',min(vals),'max',max(vals),'seedmeans',[round(x)for x in means])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
