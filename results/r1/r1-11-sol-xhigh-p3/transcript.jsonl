{"type":"item.started","item":{"id":"item_123","type":"command_execution","command":"/bin/bash -lc \".venv/bin/python - <<'PY'\nimport concurrent.futures,sys,statistics\nsys.path.insert(0,'tools');variants=(0,3,6,9)\ndef one(t):\n coef,seed=t;import engine\n def make():\n  a=engine.load_agent('main.py')\n  def cf(x,y,shops,prices=None):\n   ct={}\n   for s in shops:ct[s]=ct.get(s,0)+1\n   ws=[8+2*sum(ct.get(s,0)for s in ('BAKERY','PIZZA_SHOP','BRUNCH_SPOT','ICE_CREAM_SHOP','FARMERS_MARKET')),18+5*ct.get('PET_CAFE',0)+2*ct.get('FARMERS_MARKET',0),28+4*ct.get('PIZZA_SHOP',0)+4*ct.get('FARMERS_MARKET',0),30+coef*sum(ct.get(s,0)for s in ('BRUNCH_SPOT','ICE_CREAM_SHOP','SMOOTHIE_SHOP','FARMERS_MARKET')),16]\n   r=((x*37+y*61+x*y*7)%101)/101.;acc=0;cs=('WHEAT','CARROT','TOMATO','STRAWBERRY','MELON');tot=sum(ws)\n   for c,w in zip(cs,ws):\n    acc+=w/tot\n    if r<acc:return c\n   return'MELON'\n  a.__globals__['_crop_for']=cf;return a\n return coef,seed,engine.play(make(),make(),seed)\nwith concurrent.futures.ProcessPoolExecutor(max_workers=8) as ex:r=list(ex.map(one,[(n,s)for n in variants for s in range(1,13)]))\nfor n in variants:\n v=[x for a,s,z in r if a==n for x in z];ms=[sum(z)/2 for a,s,z in r if a==n];print(n,round(statistics.mean(v)),round(statistics.median(v)),min(v),max(v),[round(x)for x in ms])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
