{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \".venv/bin/python - <<'PY'\nimport concurrent.futures,sys,statistics\nsys.path.insert(0,'tools')\nvariants={\n 'base':(8,18,28,30,16),\n 'straw':(5,15,25,45,10),\n 'caps':(5,20,30,35,10),\n 'premium':(5,15,20,40,20),\n 'ts':(5,10,35,40,10),\n 'balanced':(10,20,25,30,15),\n}\ndef one(task):\n name,weights,seed=task\n import engine\n def make():\n  a=engine.load_agent('main.py'); crops=('WHEAT','CARROT','TOMATO','STRAWBERRY','MELON'); total=sum(weights)\n  def cf(x,y,shops,prices=None):\n   rank=((x*37+y*61+x*y*7)%101)/101.;acc=0\n   for c,w in zip(crops,weights):\n    acc+=w/total\n    if rank<acc:return c\n   return 'MELON'\n  a.__globals__['_crop_for']=cf;return a\n return name,seed,engine.play(make(),make(),seed)\ntasks=[(n,w,s) for n,w in variants.items() for s in range(1,5)]\nwith concurrent.futures.ProcessPoolExecutor(max_workers=8) as ex:r=list(ex.map(one,tasks))\nfor n in variants:\n vals=[x for a,s,z in r if a==n for x in z]\n print(n,round(statistics.mean(vals)),min(vals),max(vals),[(s,z) for a,s,z in r if a==n])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
