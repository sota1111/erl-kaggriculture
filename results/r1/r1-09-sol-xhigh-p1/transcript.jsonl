{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \".venv/bin/python - <<'PY'\nfrom kaggle_environments.envs.kaggriculture import kaggriculture as kg\nprint(kg.__file__)\nPY\nsed -n '1,260p' docs/env/kaggriculture.json\"","aggregated_output":"/home/vscode/dev/2026/erl-kaggriculture/.runs/r1-09-sol-xhigh-p1/.venv/lib/python3.12/site-packages/kaggle_environments/envs/kaggriculture/kaggriculture.py\n{\n  \"name\": \"kaggriculture\",\n  \"title\": \"Kaggriculture\",\n  \"description\": \"Advanced farming simulation: two players each tend a 10x10 farm of four 5x5 quadrants, growing crops, raising animals, hiring help, and trading with a dynamic market over one season.\",\n  \"version\": \"0.1.0\",\n  \"agents\": [2],\n  \"configuration\": {\n    \"episodeSteps\": 720,\n    \"actTimeout\": 1,\n    \"boardSize\": {\n      \"description\": \"Width and height (in tiles) of each player's square farm. Advanced game expects 10 (four 5x5 quadrants).\",\n      \"type\": \"integer\",\n      \"default\": 10,\n      \"minimum\": 4\n    },\n    \"startingMoney\": {\n      \"description\": \"Money each player starts with.\",\n      \"type\": \"integer\",\n      \"default\": 3000,\n      \"minimum\": 0\n    },\n    \"maxMarketOrdersPerTurn\": {\n      \"description\": \"Maximum number of market orders processed per player per turn. Extra orders beyond this limit are silently dropped.\",\n      \"type\": \"integer\",\n      \"default\": 10,\n      \"minimum\": 1\n    },\n    \"turnsPerDay\": {\n      \"description\": \"Number of turns that make up one in-game day.\",\n      \"type\": \"integer\",\n      \"default\": 24,\n      \"minimum\": 1\n    },\n    \"shedCapacity\": {\n      \"description\": \"Maximum number of non-seed items the shed can hold (overflow at end-of-day drop is discarded).\",\n      \"type\": \"integer\",\n      \"default\": 100,\n      \"minimum\": 1\n    },\n    \"weedSpawnChance\": {\n      \"description\": \"Per-tile probability of a weed spawning on an empty unlocked tile during the end-of-day refresh.\",\n      \"type\": \"number\",\n      \"default\": 0.005,\n      \"minimum\": 0\n    },\n    \"townShopUnlockInterval\": {\n      \"description\": \"Days between successive town shop unlocks. First shop unlocks on day equal to this value. Shops are drawn with replacement, so the same shop can unlock more than once; unlocking stops after 8 instances.\",\n      \"type\": \"integer\",\n      \"default\": 3,\n      \"minimum\": 1\n    },\n    \"townShopSellInterval\": {\n      \"description\": \"Number of turns between successive consumption ticks by every unlocked town shop instance. Each instance pulls one of each of its products per tick (single-product shops pull 2x), so a duplicated shop consumes once per copy. Total demand grows monotonically as more shops are unlocked.\",\n      \"type\": \"integer\",\n      \"default\": 4,\n      \"minimum\": 1\n    },\n    \"townCenterSellInterval\": {\n      \"description\": \"Number of turns between successive consumption ticks by the town center (one of every non-fertilizer product per tick). At the default of 24 with turnsPerDay 24, the town center buys once per day at a flat rate for the whole season.\",\n      \"type\": \"integer\",\n      \"default\": 24,\n      \"minimum\": 1\n    },\n    \"seed\": {\n      \"description\": \"Optional input seed for deterministic episode generation. The interpreter clears this from configuration after reading and stores the resolved seed on env.info['seed'] so it stays out of agent observations but is still recorded in the replay.\",\n      \"type\": [\"integer\", \"null\"],\n      \"default\": null\n    },\n    \"farmHandCostMult\": {\n      \"description\": \"Multiplier applied to the Fibonacci hire-cost sequence (1, 1, 2, 3, 5, 8, 13, ...). The n-th hire of the day costs this value times fib(n).\",\n      \"type\": \"integer\",\n      \"default\": 1,\n      \"minimum\": 0\n    },\n    \"marketParams\": {\n      \"description\": \"Per-resource market price-curve overrides. Sparse: keyed by product name; each entry may set any subset of {base, I0, T, below_func, below_target, above_func, above_target}. Missing keys (and missing products) inherit from MARKET_PARAMS defaults in kaggriculture.py. Functions: linear, sq, sqrt, log, log10, hinge. amp is derived as target * base / f(T). The hinge function is flat-ish below T and spikes above it, and unlike the others it is scaled by T so that f(T) = 1.\",\n      \"type\": \"object\",\n      \"default\": {}\n    }\n  },\n  \"reward\": {\n    \"description\": \"Player money at end of game (final score).\",\n    \"type\": \"number\",\n    \"default\": 0\n  },\n  \"observation\": {\n    \"player\": {\n      \"description\": \"Player ID (0 or 1).\",\n      \"type\": \"integer\",\n      \"default\": 0\n    },\n    \"farms\": {\n      \"description\": \"Per-player public farm state visible to all agents (tiles, money, farmer/hand positions, unlocked quadrants, hire count). Indexed by player id. Opponent shed and per-farmer inventories are NOT included here.\",\n      \"type\": \"array\",\n      \"shared\": true,\n      \"default\": []\n    },\n    \"private\": {\n      \"description\": \"Per-agent private state for THIS player only: shed inventory, per-farmer inventories, seed counts. Not shared.\",\n      \"type\": \"object\",\n      \"shared\": false,\n      \"default\": {}\n    },\n    \"market\": {\n      \"description\": \"Shared market state: current per-product inventory and price.\",\n      \"type\": \"object\",\n      \"shared\": true,\n      \"default\": {}\n    },\n    \"town\": {\n      \"description\": \"Shared town state: list of unlocked shop names. Each unlocked shop generates per-tick demand for its products.\",\n      \"type\": \"object\",\n      \"shared\": true,\n      \"default\": {}\n    },\n    \"day\": {\n      \"description\": \"Current in-game day (0-indexed).\",\n      \"type\": \"integer\",\n      \"shared\": true,\n      \"default\": 0\n    },\n    \"hour\": {\n      \"description\": \"Current turn within the day (0-indexed).\",\n      \"type\": \"integer\",\n      \"shared\": true,\n      \"default\": 0\n    },\n    \"remainingOverageTime\": 60\n  },\n  \"action\": {\n    \"description\": \"Per-turn action of the form {\\\"farmer\\\": [op, ...args], \\\"hands\\\": [[op, ...args], ...], \\\"market\\\": [[op, ...args], ...]}. Farmer/hand ops: NORTH, SOUTH, EAST, WEST, PASS, PICKUP <item> [n], PLANT <crop>, WATER, HARVEST, FERTILIZE, BUILD_COOP, BUILD_PASTURE, DIG, PLACE <item> [n], FEED, COLLECT_FERTILIZER, CARE. Market ops: BUY_SEED <crop> <n>, BUY_PRODUCT <item> <n>, BUY_ANIMAL <animal> <n>, SELL <item> <n>, HIRE, BUY_LAND.\",\n    \"type\": \"object\",\n    \"default\": { \"farmer\": [\"PASS\"], \"hands\": [], \"market\": [] }\n  },\n  \"status\": {\n    \"defaults\": [\"ACTIVE\", \"ACTIVE\"]\n  }\n}\n","exit_code":0,"status":"completed"}}
